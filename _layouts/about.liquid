---
layout: default
---
<div class="post">
  <article>
    <header class="post-header">
      <h1 class="post-title">
        {% if site.title == 'blank' %}
          <span class="font-weight-bold">{{ site.first_name }} {{ site.last_name }}</span>
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      <p class="desc">{{ page.subtitle }}</p>
      <p class="header-links">
        <a href="mailto:sunchanpark@pusan.ac.kr">sunchanpark@pusan.ac.kr</a> |
        <a href="https://scholar.google.com/citations?user=fIEVUXAAAAAJ">Google Scholar</a> |
        <a href="https://orcid.org/0009-0004-2145-819X">ORCID</a> |
        <a href="https://www.linkedin.com/in/sunchan-park-72141b187">LinkedIn</a>
      </p>
    </header>

    <div class="clearfix">{{ content }}</div>

    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>
        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}
  </article>
</div>
